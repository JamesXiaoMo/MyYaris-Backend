# ==========================================
# MyYaris Backend Configuration Example
# Copy to .env and adjust as necessary
# ==========================================

# Server Host and Port
HOST=127.0.0.1
PORT=8000

# Base Data Directory for SQLite & Temp Audio
# Default: ~/.local/share/myyaris
MYYARIS_DATA_DIR=/home/<USER>/.local/share/myyaris

# SQLite Connection URL (leave empty to use default inside DATA_DIR)
# DATABASE_URL=sqlite:////home/<USER>/.local/share/myyaris/myyaris.db

# Authentication Tokens (CRITICAL: Generate strong random tokens before running)
CAR_TOKEN=GENERATE_RANDOM_CAR_TOKEN_HERE
PHONE_TOKEN=GENERATE_RANDOM_PHONE_TOKEN_HERE
ADMIN_TOKEN=GENERATE_RANDOM_ADMIN_TOKEN_HERE

# Target Device Configuration
DEFAULT_CAR_DEVICE_ID=car_p3pro

# Polling and Task Expiry Policies
LONG_POLL_TIMEOUT_SECONDS=20
TASK_DEFAULT_EXPIRY_MINUTES=60
ACK_TIMEOUT_SECONDS=30
MAX_ACTIVE_LONG_POLL_PER_DEVICE=2

# Audio Retention
AUDIO_RETENTION_HOURS=24

# External Providers (none | whisper_local | openai | gemini | google)
ASR_PROVIDER=none
ASR_API_KEY=
NLP_PROVIDER=none
NLP_API_KEY=
MAPS_PROVIDER=google
GOOGLE_MAPS_API_KEY=

# In production, mock fallback is strictly disabled (false) to prevent fake coordinate navigation
ALLOW_MOCK_FALLBACK=false
