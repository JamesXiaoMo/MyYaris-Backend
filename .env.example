# ==========================================
# MyYaris Backend Configuration Example
# Copy to .env and adjust as necessary
# ==========================================

# Server Host and Port
HOST=127.0.0.1
PORT=8000

# Base Data Directory for SQLite & Temp Audio
# Default: ~/.local/share/myyaris
MYYARIS_DATA_DIR=/path/to/user/.local/share/myyaris

# SQLite Connection URL (leave empty to use default inside DATA_DIR)
# DATABASE_URL=sqlite:////path/to/user/.local/share/myyaris/myyaris.db

# Authentication Tokens (Placeholder values - replace in real deployment)
CAR_TOKEN=myyaris-car-secret-token
PHONE_TOKEN=myyaris-phone-secret-token
ADMIN_TOKEN=myyaris-admin-secret-token

# Target Device Configuration
DEFAULT_CAR_DEVICE_ID=car_p3pro

# Polling and Task Expiry Policies
LONG_POLL_TIMEOUT_SECONDS=20
TASK_DEFAULT_EXPIRY_MINUTES=60
ACK_TIMEOUT_SECONDS=30
MAX_ACTIVE_LONG_POLL_PER_DEVICE=2

# Audio Retention
AUDIO_RETENTION_HOURS=24

# External Providers (mock | none | whisper_local | openai | gemini | google)
ASR_PROVIDER=mock
ASR_API_KEY=
NLP_PROVIDER=mock
NLP_API_KEY=
MAPS_PROVIDER=mock
GOOGLE_MAPS_API_KEY=

# Fallback to test double/mock when API keys are not supplied
ALLOW_MOCK_FALLBACK=true
