[Unit]
Description=MyYaris Navigation Backend Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/<DEPLOY_USER>/myyaris/backend
ExecStart=/home/<DEPLOY_USER>/myyaris/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3s
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/<DEPLOY_USER>/myyaris/backend/.env

[Install]
WantedBy=default.target
