[Unit]
Description=MyYaris Navigation Backend Service
After=network.target tailscaled.service

[Service]
Type=simple
User=<DEPLOY_USER>
WorkingDirectory=/home/<DEPLOY_USER>/myyaris/backend
ExecStart=/home/<DEPLOY_USER>/myyaris/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5s
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/<DEPLOY_USER>/myyaris/backend/.env

# Basic sandboxing
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/<DEPLOY_USER>/.local/share/myyaris /home/<DEPLOY_USER>/myyaris/backend

[Install]
WantedBy=multi-user.target
